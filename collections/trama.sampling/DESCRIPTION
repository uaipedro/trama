Package: trama.sampling
Title: Survey Sampling Collection for trama
Version: 0.1.0
Authors@R: c(
    person("Pedro", "Mambelli Fernandes", , "pedromambelli@gmail.com",
           role = c("aut", "cre"),
           comment = c(ORCID = "0009-0001-1695-279X")),
