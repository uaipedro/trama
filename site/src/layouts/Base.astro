---
import "../styles/site.css";
import { variants } from "../data/copy-variants";
import { collections } from "../data/collections";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "R em blocos executáveis." } = Astro.props;
const pageTitle = title === "trama" ? title : `${title} · trama`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/trama/og-trama.png", Astro.site);
---

<!doctype html>
<html lang="pt-BR" data-facilitador="on">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eef2f4" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/trama/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="trama" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="trama — R em blocos executáveis" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{pageTitle}</title>
    <script is:inline>
      const store = {
        get(key) {
          try { return localStorage.getItem(key); } catch { return null; }
        },
        set(key, value) {
          try { localStorage.setItem(key, value); } catch {}
        },
        remove(key) {
          try { localStorage.removeItem(key); } catch {}
        }
      };
      document.documentElement.dataset.js = "true";
      document.documentElement.dataset.facilitador = store.get("trama-camada-facilitadora") ?? "on";

      const pendingAbOn = store.get("trama-ab") === "1";
      const pendingVariant = store.get("trama-variante");
      if (pendingAbOn && pendingVariant && pendingVariant !== "controle") {
        document.documentElement.setAttribute("data-copy-pending", "");
      }
    </script>
  </head>
  <body>
    <div class="ab-bar" hidden data-ab-bar>
      <span>modo comparação — só você vê</span>
      <label>Variante
        <select data-ab-select>
          {variants.map((variant) => <option value={variant.id}>{variant.name}</option>)}
        </select>
      </label>
    </div>
    <script type="application/json" id="ab-variants" set:html={JSON.stringify(variants)} />
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <header class="site-header">
      <a class="brand" href="/trama/" aria-label="trama — página inicial">
        <svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true">
          <path class="mark-frame" d="M24 2.5 43 13.5v21L24 45.5 5 34.5v-21Z" />
          <path class="mark-line mark-line-a" d="M13 18c0 7 11 6 11 14" />
          <path class="mark-line mark-line-b" d="M35 18c0 7-11 6-11 14" />
          <rect class="mark-node mark-node-a" x="9" y="11" width="8" height="8" rx="2" />
          <rect class="mark-node mark-node-b" x="31" y="11" width="8" height="8" rx="2" />
          <rect class="mark-node mark-node-c" x="20" y="29" width="8" height="8" rx="2" />
        </svg>
        <span>trama</span>
      </a>
      <nav aria-label="Navegação principal" class="main-nav">
        <a href="/trama/">Início</a>
        <details class="nav-menu">
          <summary>Coleções</summary>
          <div class="nav-menu__panel">
            {collections.map((c) => (
              <a href={`/trama/colecoes/${c.id}/`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><use href={`/trama/icons/lucide.svg#${c.icon}`} /></svg>
                <span><strong>{c.title}</strong><em>{c.description}</em></span>
              </a>
            ))}
            <a class="nav-menu__all" href="/trama/colecoes/">Ver todas as coleções →</a>
          </div>
        </details>
        <a href="/trama/por-dentro/">Por dentro do trama</a>
        <button type="button" class="search-trigger" data-search-open>Buscar <kbd>/</kbd></button>
      </nav>
      <button class="depth-toggle" type="button" aria-pressed="true" data-depth-toggle title="Liga ou desliga as caixas de contexto: explicações extras para quem está começando, sem mudar o texto principal.">
        <span class="toggle-orbit" aria-hidden="true"></span>
        <span class="toggle-copy">Contexto extra</span>
      </button>
    </header>
    <main id="conteudo">
      <slot />
    </main>
    <dialog class="search-dialog" data-search-dialog>
      <button type="button" class="search-dialog__close" data-search-close aria-label="Fechar a busca">×</button>
      <div id="search"></div>
    </dialog>
    <footer class="site-footer">
      <p><strong>trama</strong> — R em blocos executáveis.</p>
      <p><a href="https://github.com/uaipedro/trama">Código no GitHub</a> · <a href="/trama/por-dentro/instalacao/">Instalação</a></p>
    </footer>
    <script is:inline>
      const key = "trama-camada-facilitadora";
      const root = document.documentElement;
      const button = document.querySelector("[data-depth-toggle]");
      const updateToggle = () => {
        const enabled = root.dataset.facilitador !== "off";
        button?.setAttribute("aria-pressed", String(enabled));
      };
      document.querySelectorAll(".prose blockquote").forEach((quote) => {
        const lead = quote.querySelector("strong");
        if (lead?.textContent?.trim() === "Antes de continuar") {
          quote.classList.add("facilitador");
        }
      });
      updateToggle();
      button?.addEventListener("click", () => {
        root.dataset.facilitador = root.dataset.facilitador === "off" ? "on" : "off";
        store.set(key, root.dataset.facilitador);
        updateToggle();
      });

      const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
      const syncFlowVideos = () => {
        document.querySelectorAll("[data-flow-video]").forEach((video) => {
          if (!(video instanceof HTMLVideoElement)) return;
          if (motionQuery.matches) video.pause();
          else video.play().catch(() => undefined);
        });
      };
      syncFlowVideos();
      motionQuery.addEventListener("change", syncFlowVideos);

      const fullscreenButtons = document.querySelectorAll("[data-flow-fullscreen]");
      const updateFullscreenButtons = () => {
        fullscreenButtons.forEach((button) => {
          const reel = button.closest(".flow-reel");
          const active = document.fullscreenElement === reel;
          button.setAttribute("aria-label", active ? "Sair da tela cheia" : "Abrir demonstração em tela cheia");
          button.innerHTML = active ? 'Sair <span aria-hidden="true">×</span>' : 'Tela cheia <span aria-hidden="true">↗</span>';
        });
      };
      fullscreenButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const reel = button.closest(".flow-reel");
          if (!(reel instanceof HTMLElement)) return;
          if (document.fullscreenElement === reel) document.exitFullscreen();
          else reel.requestFullscreen?.().catch(() => undefined);
        });
      });
      document.addEventListener("fullscreenchange", updateFullscreenButtons);

      const navMenu = document.querySelector(".nav-menu");
      if (navMenu instanceof HTMLDetailsElement) {
        document.addEventListener("click", (event) => {
          if (navMenu.open && !navMenu.contains(event.target)) navMenu.open = false;
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && navMenu.open) {
            navMenu.open = false;
            navMenu.querySelector("summary")?.focus();
          }
        });
      }

      const searchDialog = document.querySelector("[data-search-dialog]");
      let pagefindReady = null;
      const loadPagefind = () => {
        if (pagefindReady) return pagefindReady;
        pagefindReady = Promise.all([
          new Promise((resolve, reject) => {
            const link = document.createElement("link");
            link.rel = "stylesheet";
            link.href = "/trama/pagefind/pagefind-ui.css";
            link.onload = resolve;
            link.onerror = reject;
            document.head.appendChild(link);
          }),
          import("/trama/pagefind/pagefind-ui.js")
        ]).then(() => {
          new window.PagefindUI({
            element: "#search",
            showSubResults: true,
            translations: {
              placeholder: "Buscar blocos e páginas",
              zero_results: "Nada encontrado para [SEARCH_TERM]. Tente outra palavra ou o id do bloco, como sampling/srs."
            }
          });
        });
        return pagefindReady;
      };
      const openSearch = () => {
        if (!(searchDialog instanceof HTMLDialogElement)) return;
        loadPagefind().then(() => {
          searchDialog.showModal();
          searchDialog.querySelector("input")?.focus();
        });
      };
      const closeSearch = () => {
        if (searchDialog instanceof HTMLDialogElement) searchDialog.close();
      };
      document.querySelectorAll("[data-search-open]").forEach((btn) => btn.addEventListener("click", openSearch));
      document.querySelector("[data-search-close]")?.addEventListener("click", closeSearch);
      searchDialog?.addEventListener("click", (event) => {
        if (event.target === searchDialog) closeSearch();
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "/" && !searchDialog?.open) {
          const target = event.target;
          const isTyping = target instanceof HTMLElement && (target.tagName === "INPUT" || target.tagName === "TEXTAREA" || target.isContentEditable);
          if (!isTyping) {
            event.preventDefault();
            openSearch();
          }
        }
      });

      const abKey = "trama-variante";
      const all = JSON.parse(document.getElementById("ab-variants")?.textContent ?? "[]");
      const validIds = new Set(all.map((v) => v.id));
      const params = new URLSearchParams(location.search);
      if (params.get("ab") === "0") store.remove("trama-ab");
      else if (params.has("ab")) store.set("trama-ab", "1");
      const paramVariant = params.get("v");
      if (paramVariant) {
        store.set(abKey, validIds.has(paramVariant) ? paramVariant : "controle");
      }
      const abOn = store.get("trama-ab") === "1";
      const applyVariant = (id) => {
        const v = all.find((x) => x.id === id) ?? all[0];
        if (!v) return;
        document.querySelectorAll("[data-copy]").forEach((el) => {
          const text = v.copy[el.dataset.copy];
          if (text) el.textContent = text;
        });
        document.documentElement.dataset.variante = v.id;
      };
      if (abOn) {
        const abBar = document.querySelector("[data-ab-bar]");
        const abSelect = document.querySelector("[data-ab-select]");
        abBar?.removeAttribute("hidden");
        const stored = store.get(abKey);
        const current = validIds.has(stored) ? stored : "controle";
        if (current !== stored) store.set(abKey, current);
        if (abSelect) abSelect.value = current;
        applyVariant(current);
        abSelect?.addEventListener("change", () => {
          const next = validIds.has(abSelect.value) ? abSelect.value : "controle";
          abSelect.value = next;
          store.set(abKey, next);
          applyVariant(next);
        });
      }
      document.documentElement.removeAttribute("data-copy-pending");
    </script>
    <script is:inline>
      // Abas Canvas | Código R dos exemplos das docs (canvas de exemplo).
      const exemploAbaKey = "trama-exemplo-aba";
      const lembrada = store.get(exemploAbaKey);
      const selecionarAba = (exemplo, aba, focar) => {
        const tabs = [...exemplo.querySelectorAll("[role='tab']")];
        tabs.forEach((tab) => {
          const selecionado = tab.dataset.tab === aba;
          tab.setAttribute("aria-selected", String(selecionado));
          tab.tabIndex = selecionado ? 0 : -1;
          if (selecionado && focar) tab.focus();
        });
        exemplo.querySelectorAll("[role='tabpanel']").forEach((panel) => {
          panel.classList.toggle("is-active", panel.dataset.panel === aba);
        });
      };
      if (lembrada) {
        document.querySelectorAll("[data-flow-example]").forEach((exemplo) => {
          if (exemplo.querySelector(`[role='tab'][data-tab='${lembrada}']`)) {
            selecionarAba(exemplo, lembrada, false);
          }
        });
      }
      document.addEventListener("click", (event) => {
        const tab = event.target instanceof Element ? event.target.closest("[data-flow-example] [role='tab']") : null;
        if (!tab) return;
        const exemplo = tab.closest("[data-flow-example]");
        if (!exemplo) return;
        const aba = tab.dataset.tab;
        selecionarAba(exemplo, aba, false);
        store.set(exemploAbaKey, aba);
      });
      document.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        const tab = event.target instanceof Element ? event.target.closest("[data-flow-example] [role='tab']") : null;
        if (!tab) return;
        const exemplo = tab.closest("[data-flow-example]");
        if (!exemplo) return;
        const tabs = [...exemplo.querySelectorAll("[role='tab']")];
        const indiceAtual = tabs.indexOf(tab);
        if (indiceAtual === -1) return;
        const passo = event.key === "ArrowRight" ? 1 : -1;
        const proxima = tabs[(indiceAtual + passo + tabs.length) % tabs.length];
        const aba = proxima.dataset.tab;
        selecionarAba(exemplo, aba, true);
        store.set(exemploAbaKey, aba);
        event.preventDefault();
      });
    </script>
  </body>
</html>
