---
import "../styles/site.css";
import { variants } from "../data/copy-variants";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "R em blocos executáveis." } = Astro.props;
const pageTitle = title === "trama" ? title : `${title} · trama`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/trama/og-trama.png", Astro.site);
---

<!doctype html>
<html lang="pt-BR" data-facilitador="on">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eef2f4" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/trama/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="trama" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="trama — R em blocos executáveis" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{pageTitle}</title>
    <script is:inline>
      document.documentElement.dataset.js = "true";
      document.documentElement.dataset.facilitador =
        localStorage.getItem("trama-camada-facilitadora") ?? "on";
    </script>
  </head>
  <body>
    <div class="ab-bar" hidden data-ab-bar>
      <span>modo comparação — só você vê</span>
      <label>Variante
        <select data-ab-select>
          {variants.map((variant) => <option value={variant.id}>{variant.name}</option>)}
        </select>
      </label>
    </div>
    <script type="application/json" id="ab-variants" set:html={JSON.stringify(variants)} />
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <header class="site-header">
      <a class="brand" href="/trama/" aria-label="trama — página inicial">
        <svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true">
          <path class="mark-frame" d="M24 2.5 43 13.5v21L24 45.5 5 34.5v-21Z" />
          <path class="mark-line mark-line-a" d="M13 18c0 7 11 6 11 14" />
          <path class="mark-line mark-line-b" d="M35 18c0 7-11 6-11 14" />
          <rect class="mark-node mark-node-a" x="9" y="11" width="8" height="8" rx="2" />
          <rect class="mark-node mark-node-b" x="31" y="11" width="8" height="8" rx="2" />
          <rect class="mark-node mark-node-c" x="20" y="29" width="8" height="8" rx="2" />
        </svg>
        <span>trama</span>
      </a>
      <nav aria-label="Navegação principal">
        <a href="/trama/comece/primeiro-fluxo/">Comece</a>
        <a href="/trama/#colecoes">Coleções</a>
      </nav>
      <button class="depth-toggle" type="button" aria-pressed="true" data-depth-toggle>
        <span class="toggle-orbit" aria-hidden="true"></span>
        <span class="toggle-copy">Mostrar contexto</span>
      </button>
    </header>
    <main id="conteudo">
      <slot />
    </main>
    <footer class="site-footer">
      <p><strong>trama</strong> — R em blocos executáveis.</p>
      <p>Documentação das coleções do trama.</p>
    </footer>
    <script is:inline>
      const key = "trama-camada-facilitadora";
      const root = document.documentElement;
      const button = document.querySelector("[data-depth-toggle]");
      const updateToggle = () => {
        const enabled = root.dataset.facilitador !== "off";
        button?.setAttribute("aria-pressed", String(enabled));
        const copy = button?.querySelector(".toggle-copy");
        if (copy) copy.textContent = enabled ? "Mostrar contexto" : "Ocultar contexto";
      };
      document.querySelectorAll(".prose blockquote").forEach((quote) => {
        const lead = quote.querySelector("strong");
        if (lead?.textContent?.trim() === "Antes de continuar") {
          quote.classList.add("facilitador");
        }
      });
      updateToggle();
      button?.addEventListener("click", () => {
        root.dataset.facilitador = root.dataset.facilitador === "off" ? "on" : "off";
        localStorage.setItem(key, root.dataset.facilitador);
        updateToggle();
      });

      const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
      const syncFlowVideos = () => {
        document.querySelectorAll("[data-flow-video]").forEach((video) => {
          if (!(video instanceof HTMLVideoElement)) return;
          if (motionQuery.matches) video.pause();
          else video.play().catch(() => undefined);
        });
      };
      syncFlowVideos();
      motionQuery.addEventListener("change", syncFlowVideos);

      const fullscreenButtons = document.querySelectorAll("[data-flow-fullscreen]");
      const updateFullscreenButtons = () => {
        fullscreenButtons.forEach((button) => {
          const reel = button.closest(".flow-reel");
          const active = document.fullscreenElement === reel;
          button.setAttribute("aria-label", active ? "Sair da tela cheia" : "Abrir demonstração em tela cheia");
          button.innerHTML = active ? 'Sair <span aria-hidden="true">×</span>' : 'Tela cheia <span aria-hidden="true">↗</span>';
        });
      };
      fullscreenButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const reel = button.closest(".flow-reel");
          if (!(reel instanceof HTMLElement)) return;
          if (document.fullscreenElement === reel) document.exitFullscreen();
          else reel.requestFullscreen?.().catch(() => undefined);
        });
      });
      document.addEventListener("fullscreenchange", updateFullscreenButtons);

      const abKey = "trama-variante";
      const params = new URLSearchParams(location.search);
      if (params.get("ab") === "0") localStorage.removeItem("trama-ab");
      else if (params.has("ab")) localStorage.setItem("trama-ab", "1");
      if (params.get("v")) localStorage.setItem(abKey, params.get("v"));
      const abOn = localStorage.getItem("trama-ab") === "1";
      const all = JSON.parse(document.getElementById("ab-variants")?.textContent ?? "[]");
      const applyVariant = (id) => {
        const v = all.find((x) => x.id === id) ?? all[0];
        if (!v) return;
        document.querySelectorAll("[data-copy]").forEach((el) => {
          const text = v.copy[el.dataset.copy];
          if (text) el.textContent = text;
        });
        document.documentElement.dataset.variante = v.id;
      };
      if (abOn) {
        const abBar = document.querySelector("[data-ab-bar]");
        const abSelect = document.querySelector("[data-ab-select]");
        abBar?.removeAttribute("hidden");
        const current = localStorage.getItem(abKey) ?? "controle";
        if (abSelect) abSelect.value = current;
        applyVariant(current);
        abSelect?.addEventListener("change", () => {
          localStorage.setItem(abKey, abSelect.value);
          applyVariant(abSelect.value);
        });
      }
    </script>
  </body>
</html>
