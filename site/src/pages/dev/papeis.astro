---
// Protótipo: ?variant=base|raw|brutal|hardware compara o card atual com a primeira alternativa.
// A vitrine usa o CSS do editor; as variações ficam só nesta página.
import "../../../../inst/www/trama.css";
import LabCard from "../../components/LabCard.astro";

// Família visual explícita: a cor original do editor não define o tipo.
// O identificador exato continua no catálogo; a forma resume o que passa no fio.
type FamiliaPorta = "tabela" | "serie" | "modelo" | "grafico" | "objeto";
const familias: { id: FamiliaPorta; nome: string; exemplos: string }[] = [
  { id: "tabela", nome: "Tabela", exemplos: "dados, data frame" },
  { id: "serie", nome: "Série", exemplos: "observações no tempo" },
  { id: "modelo", nome: "Modelo", exemplos: "ajuste, classificador" },
  { id: "grafico", nome: "Gráfico", exemplos: "visualização" },
  { id: "objeto", nome: "Objeto de análise", exemplos: "teste, previsão, plano" },
];

const modos = [
  { id: "mini", nome: "Mini" },
  { id: "params", nome: "Parâmetros" },
  { id: "preview", nome: "Prévia" },
  { id: "completo", nome: "Completo" },
] as const;

const exemplos = [
  { titulo: "Dados de exemplo", icone: "flask-conical", categoria: "Fonte · Dados", cor: "#6366f1", saida: ["out", "#38bdf8", "tabela"], params: [{ nome: "Conjunto", valor: "ChickWeight" }], vista: "tabela", tipo: "tabela", estado: "done" },
  { titulo: "Resumo", icone: "clipboard-list", categoria: "Conhecer · Dados", cor: "#f59e0b", entrada: ["data", "#38bdf8", "tabela"], saida: ["out", "#38bdf8", "tabela"], params: [], vista: "tabela", tipo: "resumo", estado: "done" },
  { titulo: "Limpar nomes", icone: "case-lower", categoria: "Limpar · Dados", cor: "#14b8a6", entrada: ["data", "#38bdf8", "tabela"], saida: ["out", "#38bdf8", "tabela"], params: [], vista: "tabela", tipo: "limpeza", estado: "cached" },
  { titulo: "Modelo misto", icone: "layers", categoria: "Ajustar · Modelos", cor: "#14b8a6", entrada: ["dados", "#38bdf8", "tabela"], saida: ["out", "#14b8a6", "modelo"], params: [{ nome: "Fórmula", valor: "weight ~ Time + (1|Chick)" }, { nome: "REML", valor: "sim" }], vista: "resumo", tipo: "modelo", estado: "done" },
  { titulo: "Disperso", icone: "chart-scatter", categoria: "Relação · Visualização", cor: "#f472b6", entrada: ["dados", "#38bdf8", "tabela"], saida: ["out", "#f472b6", "grafico"], params: [{ nome: "Eixo X", valor: "Time" }, { nome: "Eixo Y", valor: "weight" }], vista: "imagem", tipo: "grafico", estado: "done" },
  { titulo: "Gravar CSV", icone: "save", categoria: "Saída · Dados", cor: "#22c55e", entrada: ["data", "#38bdf8", "tabela"], saida: ["out", "#38bdf8", "tabela"], params: [{ nome: "Arquivo", valor: "saida/pintos.csv" }], vista: "tabela", tipo: "arquivo", estado: "done" },
  { titulo: "ARIMA", icone: "activity", categoria: "Modelar · Séries temporais", cor: "#f59e0b", entrada: ["serie", "#34d399", "serie"], saida: ["out", "#f59e0b", "modelo"], params: [{ nome: "Automático", valor: "sim" }, { nome: "Parte sazonal", valor: "sim" }], vista: "resumo", tipo: "arima", estado: "running" },
  { titulo: "Avaliar previsões", icone: "scan-search", categoria: "Prever e avaliar · Aprendizado", cor: "#2563eb", entrada: ["dados", "#38bdf8", "tabela"], saida: ["out", "#38bdf8", "tabela"], params: [{ nome: "Alvo", valor: "weight" }, { nome: "Predito", valor: ".pred" }], vista: "tabela", tipo: "avaliacao", estado: "failed" },
  { titulo: "Série de exemplo", icone: "activity", categoria: "Fonte · Séries temporais", cor: "#34d399", saida: ["out", "#34d399", "serie"], params: [{ nome: "Série", valor: "AirPassengers" }], vista: "imagem", tipo: "serie", estado: "done" },
  { titulo: "Teste dos aleatórios", icone: "shuffle", categoria: "Resumir · Modelos", cor: "#eab308", entrada: ["modelo", "#14b8a6", "modelo"], saida: ["out", "#eab308", "objeto"], params: [], vista: "tabela", tipo: "teste", estado: "done" },
] as const;

// Trama de exemplo: posições no canvas e fios (de → para), só para a variante hardware.
const porTitulo = (titulo: string) => exemplos.find((e) => e.titulo === titulo)!;
const nos = [
  { id: "dados", exemplo: porTitulo("Dados de exemplo"), x: 30, y: 150 },
  { id: "limpar", exemplo: porTitulo("Limpar nomes"), x: 350, y: 30 },
  { id: "gravar", exemplo: porTitulo("Gravar CSV"), x: 350, y: 400 },
  { id: "resumo", exemplo: porTitulo("Resumo"), x: 680, y: 10 },
  { id: "modelo", exemplo: porTitulo("Modelo misto"), x: 680, y: 330 },
  { id: "disperso", exemplo: porTitulo("Disperso"), x: 1010, y: 10 },
  { id: "avaliar", exemplo: porTitulo("Avaliar previsões"), x: 1010, y: 360 },
];
const fios = [["dados", "limpar"], ["dados", "gravar"], ["limpar", "resumo"], ["limpar", "modelo"], ["resumo", "disperso"], ["modelo", "avaliar"]];

const temas = [
  { id: "claro", nome: "Claro" },
  { id: "escuro", nome: "Escuro" },
] as const;

// Gramática das saídas (estudo): FORMA = papel da porta, COR = família do dado.
// fluxo ▶ segue a linha principal; objeto ■ é a coisa ajustada, reaproveitável;
// anexo ● é um derivado que se pendura embaixo do card, fora do fluxo.
type Papel = "fluxo" | "objeto" | "anexo";
type PortaG = [string, Papel, FamiliaPorta, boolean?];
const gramatica: { titulo: string; icone: string; cor: string; entradas: PortaG[]; saidas: PortaG[]; anexos: PortaG[] }[] = [
  { titulo: "Limpar nomes", icone: "ab", cor: "#14b8a6", entradas: [["dados", "fluxo", "tabela"]], saidas: [["out", "fluxo", "tabela"]], anexos: [] },
  { titulo: "Separar treino/teste", icone: "⑂", cor: "#2563eb", entradas: [["dados", "fluxo", "tabela"]], saidas: [["treino", "fluxo", "tabela"], ["teste", "fluxo", "tabela"]], anexos: [] },
  { titulo: "Modelo misto", icone: "≋", cor: "#14b8a6", entradas: [["dados", "fluxo", "tabela"]], saidas: [["resumo", "fluxo", "tabela"], ["modelo", "objeto", "modelo"]], anexos: [["resíduos", "anexo", "tabela", true], ["coeficientes", "anexo", "tabela"], ["aleatórios", "anexo", "tabela"]] },
  { titulo: "Prever", icone: "→", cor: "#2563eb", entradas: [["modelo", "objeto", "modelo"], ["dados", "fluxo", "tabela"]], saidas: [["previsões", "fluxo", "tabela"]], anexos: [] },
  { titulo: "ARIMA", icone: "∿", cor: "#f59e0b", entradas: [["série", "fluxo", "serie"]], saidas: [["previsão", "fluxo", "serie"], ["modelo", "objeto", "modelo"]], anexos: [["resíduos", "anexo", "serie"], ["diagnóstico", "anexo", "grafico"]] },
  { titulo: "PCA", icone: "⊹", cor: "#a855f7", entradas: [["dados", "fluxo", "tabela"]], saidas: [["escores", "fluxo", "tabela"], ["pca", "objeto", "objeto"]], anexos: [["cargas", "anexo", "tabela"], ["variância", "anexo", "tabela"], ["biplot", "anexo", "grafico"]] },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/trama/favicon.svg" type="image/svg+xml" />
    <title>Cards do editor · laboratório trama</title>
  </head>
  <body class="lab" data-variant="base">
    <main class="lab__shell">
      <header class="lab__topo">
        <a href="/trama/" class="lab__marca">trama <span>/ laboratório</span></a>
        <div class="lab__intro">
          <div><h1>Cards do editor</h1><p>Compare o card atual com alternativas usando as mesmas amostras.</p></div>
          <div class="lab__modos" role="group" aria-label="Modo de todos os cards">
            {modos.map((modo) => <button type="button" data-modo-global={modo.id} aria-pressed={modo.id === "completo"}>{modo.nome}</button>)}
          </div>
        </div>
      </header>

      <section class="lab__portas-estudo" aria-label="Proposta de linguagem das portas">
        <div class="lab__portas-intro"><strong>O que passa no fio</strong><span>A forma indica a família; o rótulo identifica a porta.</span></div>
        <div class="lab__portas-familias">
          {familias.map((familia) => <div class="lab__porta-item"><span class={`lab__porta-simbolo lab__porta-simbolo--${familia.id}`} aria-hidden="true"></span><span><strong>{familia.nome}</strong><small>{familia.exemplos}</small></span></div>)}
        </div>
        <div class="lab__portas-direcao"><span><i class="lab__porta-simbolo lab__porta-simbolo--tabela lab__porta-simbolo--vazada" aria-hidden="true"></i> entrada</span><span><i class="lab__porta-simbolo lab__porta-simbolo--tabela" aria-hidden="true"></i> saída</span></div>
      </section>

      <div class="lab__temas">
        {temas.map((tema) => <section class={`lab__tema lab__tema--${tema.id}`} aria-labelledby={`tema-${tema.id}`}>
          <header class="lab__tema-cabecalho"><h2 id={`tema-${tema.id}`}>{tema.nome}</h2><span>{tema.id === "claro" ? "tema claro do editor" : "tema escuro do editor"}</span></header>
          <div class="lab__grade">
            {exemplos.map((exemplo) => <div class="lab__amostra">
              <LabCard exemplo={exemplo} modos={modos} />
            </div>)}
          </div>
        </section>)}
      </div>

      <section class="lab__trama lab__tema lab__tema--claro" aria-labelledby="trama-titulo" data-trama>
        <header class="lab__tema-cabecalho"><h2 id="trama-titulo">Trama</h2>
          <div class="lab__trama-acoes"><span>arraste os cards para testar o cabo</span>
<div class="lab__modos" role="group" aria-label="Tema da trama"><button type="button" data-trama-tema="claro" aria-pressed="true">Claro</button><button type="button" data-trama-tema="escuro" aria-pressed="false">Escuro</button></div>
          </div>
        </header>
        <div class="lab__trama-canvas" data-trama-canvas>
          <svg class="lab__cabos" data-cabos aria-hidden="true">
            {fios.map(([de, para]) => <g class="lab__cabo" data-de={de} data-para={para}><path class="lab__cabo-trilho" /><path class="lab__cabo-pulso" /></g>)}
            <g data-encaixes></g>
          </svg>
          {nos.map((no) => <div class="lab__amostra lab__no" data-no-id={no.id} style={`left:${no.x}px;top:${no.y}px`}><LabCard exemplo={no.exemplo} modos={modos} id={no.id} /></div>)}
        </div>
      </section>
      <section class="gram" aria-labelledby="gram-titulo">
        <header class="gram__cab">
          <div><h2 id="gram-titulo">Gramática das saídas</h2><p>Forma diz o papel da porta; cor diz a família do dado. Passe o mouse numa porta para ver o nome; segure <kbd>Alt</kbd> para ver todos. Anexos só aparecem com o card selecionado (clique) ou quando ligados.</p></div>
          <ul class="gram__legenda">
            <li><i class="gp gp--fluxo" style="--c:var(--porta-tabela)"></i><b>Fluxo</b><small>o que segue a linha</small></li>
            <li><i class="gp gp--objeto" style="--c:var(--porta-modelo)"></i><b>Objeto</b><small>a coisa ajustada, reaproveitável</small></li>
            <li><i class="gp gp--anexo" style="--c:var(--porta-tabela)"></i><b>Anexo</b><small>derivado, pende embaixo</small></li>
          </ul>
        </header>
        {temas.map((tema) => <div class={`gram__palco lab__tema--${tema.id}`}>
          {gramatica.map((g) => <article class="gram__card" tabindex="0">
            <div class="gram__head" style={`--cat:${g.cor}`}><span class="gram__ic">{g.icone}</span>{g.titulo}</div>
            <div class="gram__portas">
              <div>{g.entradas.map(([n, papel, fam]) => <button type="button" class="gram__porta gram__porta--in" aria-label={`entrada: ${n} (${fam})`}><i class={`gp gp--${papel}`} style={`--c:var(--porta-${fam})`}></i><span class="gram__dica gram__dica--esq">{n}<small>{fam}</small></span></button>)}</div>
              <div>{g.saidas.map(([n, papel, fam]) => <button type="button" class="gram__porta gram__porta--out" aria-label={`saída: ${n} (${fam})`}><i class={`gp gp--${papel}`} style={`--c:var(--porta-${fam})`}></i><span class="gram__dica gram__dica--dir">{n}<small>{fam}</small></span></button>)}</div>
            </div>
            {g.anexos.length > 0 && <div class="gram__anexos">{g.anexos.map(([n, papel, fam, ligado]) => <button type="button" class:list={["gram__anexo", { "gram__anexo--ligado": ligado }]} aria-label={`anexo: ${n} (${fam})`}><i class={`gp gp--${papel}`} style={`--c:var(--porta-${fam})`}></i><span class="gram__dica">{n}<small>{fam}</small></span></button>)}</div>}
          </article>)}
        </div>)}
      </section>
    </main>
    <nav class="lab__variantes" aria-label="Comparar alternativas do laboratório">
      <button type="button" data-variant-step="-1" aria-label="Alternativa anterior">←</button>
      <span data-variant-label aria-live="polite">Base · card atual</span>
      <button type="button" data-variant-step="1" aria-label="Próxima alternativa">→</button>
    </nav>
    <script>
      const variantes = [{ id: "base", label: "Base · card atual" }, { id: "raw", label: "A · Laboratório Raw" }, { id: "brutal", label: "B · Neo-brutalista" }, { id: "hardware", label: "C · Hardware tátil" }];
      const aplicarVariante = (id: string) => {
        const escolhida = variantes.find((v) => v.id === id) || variantes[0];
        document.body.dataset.variant = escolhida.id;
        const rotulo = document.querySelector<HTMLElement>("[data-variant-label]");
        if (rotulo) rotulo.textContent = escolhida.label;
        const url = new URL(window.location.href);
        url.searchParams.set("variant", escolhida.id);
        history.replaceState(null, "", url);
      };
      aplicarVariante(new URLSearchParams(location.search).get("variant") || "base");
      const mudarVariante = (passo: number) => {
        const indice = variantes.findIndex((v) => v.id === document.body.dataset.variant);
        aplicarVariante(variantes[(indice + passo + variantes.length) % variantes.length].id);
      };
      document.querySelectorAll<HTMLButtonElement>("[data-variant-step]").forEach((botao) => botao.addEventListener("click", () => mudarVariante(Number(botao.dataset.variantStep))));
      window.addEventListener("keydown", (evento) => {
        const alvo = evento.target as HTMLElement;
        if (alvo.closest("input, textarea, select, [contenteditable]")) return;
        if (evento.key === "ArrowLeft" || evento.key === "ArrowRight") { evento.preventDefault(); mudarVariante(evento.key === "ArrowRight" ? 1 : -1); }
      });
      const ajustar = (card: HTMLElement, modo: string) => {
        card.dataset.mode = modo;
        card.classList.toggle("tr-node-mini", modo === "mini");
        card.querySelectorAll<HTMLButtonElement>("[data-modo-card]").forEach((botao) => {
          const ativo = botao.dataset.modoCard === modo;
          botao.classList.toggle("tr-on", ativo);
          botao.setAttribute("aria-pressed", String(ativo));
        });
      };
      document.querySelectorAll<HTMLButtonElement>("[data-modo-global]").forEach((botao) => botao.addEventListener("click", () => {
        document.querySelectorAll<HTMLElement>(".lab__amostra .tr-node").forEach((card) => ajustar(card, botao.dataset.modoGlobal || "completo"));
        document.querySelectorAll<HTMLButtonElement>("[data-modo-global]").forEach((b) => b.setAttribute("aria-pressed", String(b === botao)));
      }));
      document.querySelectorAll<HTMLButtonElement>("[data-modo-card]").forEach((botao) => botao.addEventListener("click", () => {
        const card = botao.closest<HTMLElement>(".tr-node");
        if (card) ajustar(card, botao.dataset.modoCard || "completo");
        document.querySelectorAll<HTMLButtonElement>("[data-modo-global]").forEach((b) => b.setAttribute("aria-pressed", "false"));
      }));
      // Trama: fios entre tomadas; o fio fica tracejado em vermelho quando o destino falhou.
      const canvas = document.querySelector<HTMLElement>("[data-trama-canvas]");
      const desenharCabos = () => {
        if (!canvas || !canvas.offsetParent) return;
        const base = canvas.getBoundingClientRect();
        const centro = (el: Element | null) => { if (!el) return null; const r = el.getBoundingClientRect(); return { x: r.left + r.width / 2 - base.left, y: r.top + r.height / 2 - base.top }; };
        const alcance = 19; // o fio começa depois do toco sólido que sai da tomada
        const portas = new Map<Element, { x: number; y: number; lado: 1 | -1; cor: string; parado: boolean }>();
        canvas.querySelectorAll<SVGGElement>(".lab__cabo").forEach((cabo) => {
          const de = canvas.querySelector(`[data-no-id="${cabo.dataset.de}"] .lab__handle--out`);
          const para = canvas.querySelector(`[data-no-id="${cabo.dataset.para}"] .lab__handle--in`);
          const a = centro(de), b = centro(para);
          if (!de || !para || !a || !b) return;
          const cor = "var(--fio)";
          const parado = !!canvas.querySelector(`[data-no-id="${cabo.dataset.para}"] .tr-state-failed`);
          cabo.style.setProperty("--cabo-cor", cor);
          cabo.classList.toggle("lab__cabo--parado", parado);
          if (!portas.has(de)) portas.set(de, { ...a, lado: 1, cor, parado: false });
          portas.set(para, { ...b, lado: -1, cor, parado });
          const x1 = a.x + alcance, x2 = b.x - alcance;
          const folga = Math.max(60, Math.abs(x2 - x1) * 0.5);
          const d = `M${x1},${a.y} C${x1 + folga},${a.y} ${x2 - folga},${b.y} ${x2},${b.y}`;
          cabo.querySelectorAll("path").forEach((p) => p.setAttribute("d", d));
        });
        // Um encaixe por porta: as saídas que se dividem partem do mesmo toco.
        const camada = canvas.querySelector("[data-encaixes]");
        if (camada) camada.innerHTML = [...portas.values()].map(({ x, y, lado, cor, parado }) =>
          `<g class="lab__encaixe${parado ? " lab__encaixe--parado" : ""}" transform="translate(${x},${y}) scale(${lado},1)" style="--cabo-cor:${cor}">
            <path class="lab__encaixe-toco" d="M7.5,0 H${alcance + 0.5}" />
          </g>`).join("");
      };
      canvas?.querySelectorAll<HTMLElement>(".lab__no").forEach((no) => {
        no.addEventListener("pointerdown", (evento) => {
          const alvo = evento.target as HTMLElement;
          if (!alvo.closest(".tr-node-head") || alvo.closest("button")) return;
          evento.preventDefault();
          const inicio = { x: evento.clientX, y: evento.clientY, left: no.offsetLeft, top: no.offsetTop };
          no.classList.add("lab__no--pegando");
          const mover = (e: PointerEvent) => { no.style.left = `${inicio.left + e.clientX - inicio.x}px`; no.style.top = `${inicio.top + e.clientY - inicio.y}px`; desenharCabos(); };
          const soltar = () => { no.classList.remove("lab__no--pegando"); window.removeEventListener("pointermove", mover); window.removeEventListener("pointerup", soltar); };
          window.addEventListener("pointermove", mover); window.addEventListener("pointerup", soltar);
        });
      });
      document.querySelectorAll<HTMLButtonElement>("[data-trama-tema]").forEach((botao) => botao.addEventListener("click", () => {
        const secao = document.querySelector<HTMLElement>("[data-trama]");
        secao?.classList.toggle("lab__tema--claro", botao.dataset.tramaTema === "claro");
        secao?.classList.toggle("lab__tema--escuro", botao.dataset.tramaTema === "escuro");
        document.querySelectorAll<HTMLButtonElement>("[data-trama-tema]").forEach((b) => b.setAttribute("aria-pressed", String(b === botao)));
      }));
      new ResizeObserver(desenharCabos).observe(document.body);
      document.querySelectorAll("[data-variant-step], [data-modo-global], [data-modo-card]").forEach((b) => b.addEventListener("click", () => requestAnimationFrame(desenharCabos)));
      window.addEventListener("keydown", () => requestAnimationFrame(desenharCabos));
      requestAnimationFrame(desenharCabos);
    
      // Alt segurado mostra o nome de todos os anexos da gramática.
      const rotulos = (on: boolean) => document.body.classList.toggle("gram--rotulos", on);
      addEventListener("keydown", (e) => { if (e.key === "Alt") { e.preventDefault(); rotulos(true); } });
      addEventListener("keyup", (e) => { if (e.key === "Alt") rotulos(false); });
      addEventListener("blur", () => rotulos(false));

      // Selecionar card da gramática: clique alterna; clique fora limpa.
      document.addEventListener("click", (e) => {
        const card = (e.target as HTMLElement).closest(".gram__card");
        document.querySelectorAll(".gram__card.is-sel").forEach((c) => { if (c !== card) c.classList.remove("is-sel"); });
        card?.classList.toggle("is-sel");
      });
</script>
  </body>
</html>

<style>
  :global(body.lab){background:#e9ebee;color:#1b2130;font:13px/1.45 ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}
  .lab__shell{max-width:1550px;margin:auto;padding:26px clamp(18px,4vw,64px) 80px}
  .lab__topo{display:grid;gap:24px;margin-bottom:28px}.lab__marca{width:max-content;color:#1b2130;font-size:16px;font-weight:700;text-decoration:none}.lab__marca span{font-weight:400;color:#5f6b7f}
