---
import Base from "../layouts/Base.astro";
import FlowMap from "../components/FlowMap.astro";

const dataSteps = [
  { label: "Ler", tone: "source" },
  { label: "Conhecer", tone: "inspect" },
  { label: "Transformar", tone: "transform" },
  { label: "Mostrar", tone: "sink" }
] as const;
---

<Base title="trama" description="R em blocos executáveis.">
  <section class="home-hero">
    <div class="home-hero__copy">
      <p class="eyebrow">R em blocos executáveis</p>
      <h1>O caminho da análise não precisa ficar escondido no código.</h1>
      <p class="lede">O trama organiza funções R em fluxos que você monta, executa e inspeciona etapa por etapa.</p>
      <div class="home-hero__actions">
        <a class="button button--primary" href="/trama/comece/primeiro-fluxo/">Monte um primeiro fluxo <span aria-hidden="true">→</span></a>
        <a class="text-link" href="/trama/colecoes/dados/">Explore a coleção Dados</a>
      </div>
    </div>
    <div class="hero-canvas" aria-label="Fluxo de exemplo: ler dados, resumir, agrupar e mostrar gráfico">
      <div class="canvas-caption"><span class="status-dot"></span> fluxo executável</div>
      <div class="canvas-grid" aria-hidden="true"></div>
      <div class="wire wire-a"></div><div class="wire wire-b"></div><div class="wire wire-c"></div>
      <div class="node node--source"><small>fonte</small><strong>Ler CSV</strong><span>vendas.csv</span></div>
      <div class="node node--inspect"><small>conhecer</small><strong>Resumo</strong><span>8 colunas</span></div>
      <div class="node node--aggregate"><small>agregar</small><strong>Por região</strong><span>receita total</span></div>
      <div class="node node--view"><small>visualizar</small><strong>Barras</strong><span>resultado</span></div>
    </div>
  </section>

  <section class="home-path" aria-labelledby="caminho-title">
    <div>
      <p class="eyebrow">Comece pelo trabalho</p>
      <h2 id="caminho-title">Do dado ao resultado, com cada transformação à vista.</h2>
    </div>
    <FlowMap steps={dataSteps} />
  </section>

  <section class="home-collections" aria-labelledby="collections-title">
    <div class="section-intro">
      <p class="eyebrow">Coleções iniciais</p>
      <h2 id="collections-title">Aprenda pelo que você quer fazer.</h2>
    </div>
    <div class="collection-links">
      <a class="collection-link collection-link--data" href="/trama/colecoes/dados/">
        <span class="collection-link__index">01</span><span><strong>Dados</strong><em>Leia, conheça, limpe, transforme e agregue tabelas.</em></span><b aria-hidden="true">→</b>
      </a>
      <a class="collection-link collection-link--view" href="/trama/colecoes/visualizacao/">
        <span class="collection-link__index">02</span><span><strong>Visualização</strong><em>Escolha gráficos a partir da pergunta e da estrutura da tabela.</em></span><b aria-hidden="true">→</b>
      </a>
    </div>
  </section>
</Base>
