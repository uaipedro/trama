---
import Base from "../layouts/Base.astro";
import FlowMap from "../components/FlowMap.astro";
import { collections } from "../data/collections";

const firstFlowSteps = [
  { label: "Dados de exemplo", tone: "source" },
  { label: "Resumo", tone: "inspect" },
  { label: "Disperso", tone: "sink" }
] as const;
---

<Base title="trama" description="R em blocos executáveis.">
  <section class="home-hero">
    <div class="home-hero__copy">
      <p class="home-hero__subtitle">R em blocos executáveis</p>
      <h1>Seu raciocínio, visível.</h1>
      <p class="lede">O trama organiza funções R em fluxos que você monta, executa e inspeciona etapa por etapa.</p>
      <div class="home-hero__actions">
        <a class="button button--primary" href="/trama/comece/primeiro-fluxo/">Comece por aqui <span aria-hidden="true">→</span></a>
        <a class="text-link" href="/trama/colecoes/dados/">Explore a coleção Dados</a>
      </div>
      <div class="home-install">
        <p class="home-install__label">Instale no R <span>R ≥ 4.1 · via GitHub</span></p>
        <pre><code>pak::pak(c("uaipedro/trama",
  "uaipedro/trama/collections/trama.data",
  "uaipedro/trama/collections/trama.view"))</code></pre>
      </div>
    </div>
    <figure class="flow-reel flow-reel--hero flow-reel--vertical">
      <div class="flow-reel__meta"><span><i aria-hidden="true"></i> montagem real</span><span>Dados</span></div>
      <button class="flow-reel__fullscreen" type="button" data-flow-fullscreen aria-label="Abrir a montagem real em tela cheia">Tela cheia <span aria-hidden="true">↗</span></button>
      <video data-flow-video autoplay muted loop playsinline preload="metadata" poster="/trama/montagens/fluxo-vertical.jpg">
        <source src="/trama/montagens/fluxo-vertical.mp4" type="video/mp4" />
        Seu navegador não consegue mostrar esta demonstração em vídeo.
      </video>
      <figcaption>Ler, filtrar, agrupar e resumir: cada bloco mostra o próprio resultado.</figcaption>
    </figure>
  </section>

  <section class="home-path" aria-labelledby="caminho-title">
    <div class="home-path__copy">
      <p class="eyebrow">Comece aqui</p>
      <h2 id="caminho-title">Monte um primeiro fluxo em três blocos.</h2>
      <p class="home-path__lede">Use uma tabela de exemplo para reconhecer a sequência: dado, inspeção e gráfico. Depois, troque o dado — não a forma de pensar.</p>
      <FlowMap steps={firstFlowSteps} />
      <p class="home-path__lede">Quando o fluxo cresce, o caminho continua ali: volte a qualquer bloco, confira o que entrou e saiu dele e siga a partir de uma etapa concreta.</p>
      <a class="text-link home-path__link" href="/trama/comece/primeiro-fluxo/">Abrir o primeiro fluxo <span aria-hidden="true">→</span></a>
    </div>
    <figure class="flow-reel flow-reel--wide">
      <div class="flow-reel__meta"><span><i aria-hidden="true"></i> fluxo conectado</span><span>Dados</span></div>
      <button class="flow-reel__fullscreen" type="button" data-flow-fullscreen aria-label="Abrir o fluxo conectado em tela cheia">Tela cheia <span aria-hidden="true">↗</span></button>
      <video data-flow-video autoplay muted loop playsinline preload="metadata" poster="/trama/montagens/fluxo-amplo.jpg">
        <source src="/trama/montagens/fluxo-amplo.mp4" type="video/mp4" />
        Seu navegador não consegue mostrar esta demonstração em vídeo.
      </video>
      <figcaption>Um fluxo real: ler, conhecer, filtrar, agregar e juntar.</figcaption>
    </figure>
  </section>

  <section id="colecoes" class="home-collections" aria-labelledby="collections-title">
    <div class="section-intro">
      <p class="eyebrow">Coleções</p>
      <h2 id="collections-title">Aprenda pelo que você quer fazer.</h2>
    </div>
    <div class="collection-cards">
      {collections.map((collection) => (
        <a class="collection-card" href={`/trama/colecoes/${collection.id}/`}>
          <span class="collection-card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><use href={`/trama/icons/lucide.svg#${collection.icon}`} /></svg>
          </span>
          <span class="collection-card__text">
            <strong>{collection.packageName}</strong>
            <span>{collection.title}</span>
            <em>{collection.description}</em>
          </span>
          <span class="collection-card__arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>
</Base>
