---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import Base from "../layouts/Base.astro";
import HeroCanvas from "../components/HeroCanvas.astro";
import ColecoesArvore from "../components/ColecoesArvore.astro";
import { collections } from "../data/collections";
import docs from "../data/node-docs.json";
import { resolveText, type NodeDocs } from "../lib/node-docs";
import { blockResolver } from "../lib/rehype-node-docs";
import { resumoReferencias } from "../lib/bibliografia";

// O exemplo da home é a ajuda real da ANOVA em DBC, lida do mesmo JSON das
// páginas de bloco. Os pressupostos se dividem pelo campo `verificar`: os que
// apontam um bloco são avaliados com os dados; os outros dependem do
// planejamento. Se a ajuda mudar, a home muda junto.
const todos = docs as unknown as Record<string, NodeDocs>;
const dbc = todos["models/anova_dbc"];
const resolver = blockResolver("/trama");
const inline = (texto: string) =>
  texto
    .replace(/&/g, "&amp;").replace(/</g, "&lt;")
    .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
    .replace(/`([^`]+)`/g, "<code>$1</code>");
const comDados = dbc.pressupostos.filter((p) => p.verificar?.length);
const doPlanejamento = dbc.pressupostos.filter((p) => !p.verificar?.length);
const autoresCurtos = (a: string[]) =>
  a.map((x) => x.split(",")[0].replace("Pimentel-Gomes", "Pimentel-Gomes")).join(" e ");
const livros = dbc.referencias.filter((x) => x.papel !== "implementacao");
const impl = dbc.referencias.find((x) => x.papel === "implementacao");
const r = resumoReferencias(todos);
// Cobertura de oráculos, contada da tabela de docs/cobertura-oraculos.md (como em rigor.astro).
const linhasCob = readFileSync(join(process.cwd(), "..", "docs", "cobertura-oraculos.md"), "utf8")
  .split("\n").filter((l) => l.startsWith("| `"));
const contaCob = (rot: string) => linhasCob.filter((l) => l.includes(`| ${rot} |`)).length;
const cob = { total: linhasCob.length, oraculo: contaCob("com oráculo"), parcial: contaCob("parcial"), sem: contaCob("sem oráculo") };


---

<Base title="trama" description="Análise estatística em R, bloco a bloco. Cada bloco mostra o próprio resultado e traz os pressupostos do método e as referências em que ele se apoia.">
  <div data-pagefind-body>
  <div class="canvas-continuo">
  <HeroCanvas />
  <ColecoesArvore />
  </div>

  <section class="construindo" aria-labelledby="construindo-titulo" data-carrossel>
    <h2 class="construindo__titulo" id="construindo-titulo"><button type="button" class="construindo__badge" data-construindo-ir>Como estamos construindo</button></h2>
    <button type="button" class="construindo__badge construindo__badge--flutua" data-construindo-ir data-construindo-flutua aria-hidden="true" tabindex="-1">Como estamos construindo <span aria-hidden="true">↓</span></button>
    <div class="carrossel__abas" role="tablist" aria-label="Como estamos construindo">
      <button type="button" role="tab" data-ir-slide="0" aria-selected="true"><span>1</span>A documentação</button>
      <button type="button" role="tab" data-ir-slide="1" aria-selected="false"><span>2</span>A curadoria</button>
      <button type="button" role="tab" data-ir-slide="2" aria-selected="false"><span>3</span>A comunidade</button>
    </div>
    <div class="carrossel__trilho" data-trilho>
  <section class="home-ajuda carrossel__slide" data-slide="0" aria-roledescription="slide" aria-label="A documentação">
    <div class="exemplo-ajuda">
      <div class="exemplo-ajuda__col">
        <h3>Avaliados com os dados</h3>
        <ul class="exemplo-lista">
          {comDados.map((p) => (
            <li>
              <p set:html={inline(resolveText(p.texto))} />
              <p class="exemplo-lista__verif"><span>Verificar:</span>
                {p.verificar!.map((id) => { const alvo = resolver(id); return alvo ? <a href={alvo.href}>{alvo.label}</a> : <code>{id}</code>; })}
              </p>
            </li>
          ))}
        </ul>
      </div>
      <div class="exemplo-ajuda__col">
        <h3>Garantidos pelo planejamento</h3>
        <ul class="exemplo-lista exemplo-lista--estudo">
          {doPlanejamento.map((p) => (
            <li>
              <p set:html={inline(resolveText(p.texto))} />
              {p.se_falhar && <p class="exemplo-lista__falha" set:html={inline(resolveText(p.se_falhar))} />}
            </li>
          ))}
        </ul>
        <h3>De onde vem o método</h3>
        <p class="exemplo-ajuda__refs">{livros.map((x, i) => <>{i > 0 && (i === livros.length - 1 ? " e " : ", ")}{autoresCurtos(x.autores ?? [])} ({x.ano})</>)}. A conta é feita pela função <code>{impl?.pacote}::{impl?.funcao}</code>.</p>
        <a class="text-link" href="/trama/colecoes/modelos/anova-dbc/">Ajuda completa do bloco <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <p class="home-exemplo__nota">Hoje são {r.blocosComPressupostos} blocos com pressupostos documentados e {r.obras} obras citadas. Veja <a href="/trama/rigor/">como as contas são conferidas</a> e o registro de cada revisão.</p>
  </section>
  <section class="home-ajuda carrossel__slide" data-slide="1" aria-roledescription="slide" aria-label="A curadoria">
    <div class="exemplo-ajuda">
      <div class="exemplo-ajuda__col">
        <h3>Como a conta é conferida</h3>
        <ul class="exemplo-lista">
          <li>
            <p><strong>Pacotes consolidados</strong>: o resultado do bloco é comparado, número a número, com a saída de um pacote R de referência para o mesmo método.</p>
          </li>
          <li>
            <p><strong>Exemplos de livros</strong>: exemplos resolvidos em livros e artigos são refeitos no bloco, e o teste cita a fonte e a tolerância aceita.</p>
          </li>
          <li>
            <p><strong>Simulações</strong>: com dados gerados a partir de valores conhecidos, confere-se se o bloco recupera o efeito e se a taxa de erro tipo I fica no nível declarado.</p>
          </li>
        </ul>
      </div>
      <div class="exemplo-ajuda__col">
        <h3>Onde estamos</h3>
        <ul class="exemplo-lista exemplo-lista--estudo">
          <li>
            <p>De {cob.total} blocos estatísticos, <strong>{cob.oraculo}</strong> já são conferidos contra uma referência externa, {cob.parcial} em parte e {cob.sem} ainda não. A lista é pública, bloco a bloco.</p>
          </li>
          <li>
            <p>Quando uma correção muda o resultado, a <strong>versão do bloco sobe</strong> e o fluxo salvo avisa. Cada mudança entra no registro de revisão.</p>
          </li>
        </ul>
        <h3>O que nenhum teste garante</h3>
        <p class="exemplo-ajuda__refs">A casualização e a independência das observações dependem do planejamento do estudo. O bloco diz isso, em vez de fingir que verificou.</p>
        <a class="text-link" href="/trama/rigor/">Etapas de validação e registro de revisão <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="home-ajuda carrossel__slide" data-slide="2" aria-roledescription="slide" aria-label="A comunidade">
    <div class="exemplo-ajuda">
      <div class="exemplo-ajuda__col">
        <h3>Aberto a quem quiser ajudar</h3>
        <ul class="exemplo-lista">
          <li>
            <p><strong>Revisão por professores e pesquisadores</strong>: cada revisão terá nome, data e a versão do bloco revisado. Ela cobre a implementação e a documentação do método, não as análises feitas com ele.</p>
            <p class="exemplo-lista__verif"><span>Onde:</span><a href="/trama/rigor/">registro de revisão</a></p>
          </li>
          <li>
            <p><strong>Apontar um problema</strong>: um resultado estranho, um pressuposto faltando, uma referência errada. Cada aviso vira uma tarefa pública.</p>
            <p class="exemplo-lista__verif"><span>Onde:</span><a href="https://github.com/uaipedro/trama/issues">issues no GitHub</a></p>
          </li>
          <li>
            <p><strong>Propor um bloco ou uma coleção</strong>: uma coleção nova é um pacote R; o núcleo do trama não tem estatística dentro.</p>
            <p class="exemplo-lista__verif"><span>Como:</span><a href="/trama/por-dentro/">por dentro do trama</a></p>
          </li>
        </ul>
      </div>
      <div class="exemplo-ajuda__col">
        <h3>Em desenho</h3>
        <ul class="exemplo-lista exemplo-lista--estudo">
          <li>
            <p><strong>Registrar como cada pressuposto foi avaliado</strong>: qual bloco serviu de evidência, com que resultado, e quem conferiu.</p>
          </li>
          <li>
            <p><strong>Guardar as informações do estudo</strong>: delineamento, unidade experimental e origem dos dados. "Não sei" é uma resposta aceita.</p>
          </li>
        </ul>
        <h3>Código aberto</h3>
        <p class="exemplo-ajuda__refs">Livre e gratuito, com o código, os testes e o registro de revisão públicos.</p>
        <a class="text-link" href="https://github.com/uaipedro/trama">Código no GitHub <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
    </div>
    <div class="carrossel__setas">
      <button type="button" data-passo="-1" aria-label="Anterior">←</button>
      <button type="button" data-passo="1" aria-label="Próximo">→</button>
    </div>
  </section>

  <script>
    // Selo "Como estamos construindo": enquanto a seção está abaixo da dobra,
    // uma cópia flutua no pé da tela. Clicar em qualquer um leva a câmera até
    // a seção, com o selo logo abaixo da barra do site e um respiro do canvas.
    {
      const secao = document.querySelector<HTMLElement>(".construindo")!;
      const selo = secao.querySelector<HTMLElement>(".construindo__titulo")!;
      const flutua = secao.querySelector<HTMLElement>("[data-construindo-flutua]")!;
      const barra = document.querySelector<HTMLElement>(".site-bar");
      const ir = () => {
        const topo = secao.getBoundingClientRect().top + scrollY - (barra?.offsetHeight ?? 0) - 56;
        scrollTo({ top: topo, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
      };
      for (const b of secao.querySelectorAll("[data-construindo-ir]")) b.addEventListener("click", ir);
      new IntersectionObserver(([e]) => {
        // só flutua enquanto o selo de verdade está abaixo da tela
        flutua.classList.toggle("is-visivel", !e.isIntersecting && e.boundingClientRect.top > innerHeight);
      }).observe(selo);
    }

    // Carrossel por scroll-snap: as abas e as setas rolam o trilho; a aba
    // ativa acompanha o slide que está à vista (inclusive no arrasto/touch).
    for (const raiz of document.querySelectorAll<HTMLElement>("[data-carrossel]")) {
      const trilho = raiz.querySelector<HTMLElement>("[data-trilho]")!;
      const slides = [...trilho.querySelectorAll<HTMLElement>("[data-slide]")];
      const abas = [...raiz.querySelectorAll<HTMLButtonElement>("[data-ir-slide]")];
      let atual = 0;
      const ir = (i: number) => {
        atual = (i + slides.length) % slides.length;
        trilho.scrollTo({ left: slides[atual].offsetLeft - trilho.offsetLeft, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
      };
      abas.forEach((a, i) => a.addEventListener("click", () => ir(i)));
      for (const b of raiz.querySelectorAll<HTMLButtonElement>("[data-passo]")) b.addEventListener("click", () => ir(atual + Number(b.dataset.passo)));
      const obs = new IntersectionObserver((es) => {
        for (const e of es) if (e.isIntersecting) {
          atual = slides.indexOf(e.target as HTMLElement);
          abas.forEach((a, i) => a.setAttribute("aria-selected", String(i === atual)));
        }
      }, { root: trilho, threshold: 0.6 });
      slides.forEach((sl) => obs.observe(sl));
    }
  </script>

  <section class="home-comece" aria-labelledby="comece-title">
    <h2 id="comece-title" class="h2-menor">Para começar</h2>
    <ul class="comece-lista">
      <li><a href="/trama/comece/primeiro-fluxo/"><strong>Primeiro fluxo</strong><span>Tutorial curto com uma tabela de exemplo: ler, examinar e fazer um gráfico.</span></a></li>
      <li><a href="/trama/templates/"><strong>Modelos prontos</strong><span>Fluxos completos para abrir no editor, como a ANOVA acima.</span></a></li>
      <li><a href="/trama/colecoes/"><strong>Coleções</strong><span>{collections.map((c) => c.title).join(", ")}.</span></a></li>
      <li><a href="/trama/por-dentro/instalacao/"><strong>Instalação</strong><span>Programa para Windows e Linux, ou pacote do R.</span></a></li>
    </ul>
  </section>

  <section class="home-roteiro" aria-labelledby="roteiro-title">
    <div class="section-intro">
      <h2 id="roteiro-title" class="h2-menor">O que está em andamento</h2>
      <p class="home-path__lede">Os próximos passos são organizados pelos problemas que queremos resolver, e não por funcionalidade.</p>
    </div>
    <ol class="roteiro-lista">
      <li>
        <p class="roteiro-lista__estado">Em desenho</p>
        <h3>Registrar como cada pressuposto foi avaliado</h3>
        <p>Guardar no fluxo qual bloco serviu de evidência e com que resultado, e quem conferiu. Quando a evidência vier de um teste, o fluxo diz qual; o julgamento continua sendo de uma pessoa.</p>
      </li>
      <li>
        <p class="roteiro-lista__estado">Em desenho</p>
        <h3>Guardar as informações do estudo</h3>
        <p>Delineamento, unidade experimental, origem dos dados e se a análise foi planejada ou exploratória. Os blocos perguntam só quando precisam, e "não sei" é uma resposta aceita.</p>
      </li>
      <li>
        <p class="roteiro-lista__estado">Aberto a colaboração</p>
        <h3>Revisão por professores e pesquisadores</h3>
        <p>Cada revisão terá nome, data e a versão do bloco revisado. Ela cobre a implementação e a documentação do método, e não as análises feitas com ele.</p>
      </li>
    </ol>
    <p class="home-roteiro__links"><a class="text-link" href="/trama/roteiro/">Roteiro completo</a> · <a class="text-link" href="https://github.com/uaipedro/trama/issues">Propor uma revisão ou apontar um problema</a></p>
  </section>

  </div>
</Base>
