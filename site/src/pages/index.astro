---
import Base from "../layouts/Base.astro";
import FluxoVivo from "../components/FluxoVivo.astro";
import CollectionCard from "../components/CollectionCard.astro";
import { collections } from "../data/collections";
import { control } from "../data/copy-variants";

// Agrupadas pelo que a pessoa quer fazer. trama.data e trama.view vêm com o
// instalador (tools/installer/release.json, bloco "core").
const instaladas = new Set(["dados", "visualizacao"]);
const grupos = [
  { titulo: "Preparar", ids: ["dados", "visualizacao"] },
  { titulo: "Modelar", ids: ["modelos", "aprendizado", "multivariada"] },
  { titulo: "Planejar", ids: ["amostragem", "experimentos"] }
].map((grupo) => ({ ...grupo, itens: grupo.ids.map((id) => collections.find((c) => c.id === id)).filter((c) => c !== undefined) }));

---

<Base title="trama" description={control.copy.metaDescription}>
  <div data-pagefind-body>
  <section class="home-hero">
    <div class="home-hero__copy">
      <p class="home-hero__subtitle" data-copy="subtitle">{control.copy.subtitle}</p>
      <h1 data-copy="title">{control.copy.title}</h1>
      <p class="lede" data-copy="lede">{control.copy.lede}</p>
      <div class="home-hero__actions">
        <a class="button button--primary" href="/trama/comece/primeiro-fluxo/"><span data-copy="ctaPrimary">{control.copy.ctaPrimary}</span> <span aria-hidden="true">→</span></a>
        <a class="text-link" href="/trama/colecoes/"><span data-copy="ctaSecondary">{control.copy.ctaSecondary}</span></a>
      </div>
      <p class="home-install-link"><a href="/trama/por-dentro/instalacao/">Instalar o trama</a> — programa pronto para Windows e Linux; no macOS, por enquanto, é pelo pacote no seu R.</p>
    </div>
    <FluxoVivo />
  </section>

  <section class="home-path" aria-labelledby="caminho-title">
    <div class="home-path__copy">
      <h2 id="caminho-title">Monte um primeiro fluxo em três blocos</h2>
      <p class="home-path__lede">Use uma tabela de exemplo para reconhecer a sequência: dado, inspeção e gráfico. Depois, troque o dado — não a forma de pensar.</p>
      <p class="home-path__lede">Quando o fluxo cresce, o caminho continua ali: volte a qualquer bloco, confira o que entrou e saiu dele e siga a partir de uma etapa concreta.</p>
      <a class="text-link home-path__link" href="/trama/comece/primeiro-fluxo/">Abrir o primeiro fluxo <span aria-hidden="true">→</span></a>
    </div>
    <figure class="flow-reel flow-reel--wide">
      <div class="flow-reel__meta"><span><i aria-hidden="true"></i> fluxo conectado</span><span>Dados</span></div>
      <button class="flow-reel__fullscreen" type="button" data-flow-fullscreen aria-label="Abrir o fluxo conectado em tela cheia">Tela cheia <span aria-hidden="true">↗</span></button>
      <video data-flow-video autoplay muted loop playsinline preload="metadata" poster="/trama/montagens/fluxo-amplo.jpg">
        <source src="/trama/montagens/fluxo-amplo.mp4" type="video/mp4" />
        Seu navegador não consegue mostrar esta demonstração em vídeo.
      </video>
      <figcaption>Um fluxo real: ler, conhecer, filtrar, agregar e juntar.</figcaption>
    </figure>
  </section>

  <section id="colecoes" class="home-collections" aria-labelledby="collections-title">
    <h2 id="collections-title">Coleções disponíveis</h2>
    <p class="home-collections__lede">Dados e Visualização vêm com o instalador; as outras você acrescenta quando precisar.</p>
    {grupos.map((grupo) => (
      <div class="collection-group">
        <h3>{grupo.titulo}</h3>
        <div class="catalogue-list">
          {grupo.itens.map((collection) => <CollectionCard collection={collection} instalada={instaladas.has(collection.id)} />)}
        </div>
      </div>
    ))}
  </section>

  <section class="home-rigor" aria-labelledby="rigor-title">
    <h2 id="rigor-title">Um bloco estatístico só entra no trama quando a conta dele bate com um resultado publicado por outra pessoa</h2>
    <p>Cada bloco é testado contra um exemplo resolvido em livro ou contra um pacote de referência, com a tolerância declarada.</p>
    <a class="text-link" href="/trama/rigor/">Como sabemos que está certo <span aria-hidden="true">→</span></a>
  </section>
  </div>
</Base>
