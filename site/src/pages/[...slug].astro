---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import NodeMini from "../components/NodeMini.astro";
import { getNodeVisual } from "../data/node-visuals";

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const related = (await getCollection("docs"))
  .filter((item) => entry.data.related.includes(item.data.node ?? item.id));
---

<Base title={entry.data.title} description={entry.data.description}>
  <div class="doc-page">
    <aside class="doc-rail" aria-label="Nesta página">
      <a class="doc-rail__back" href={entry.data.collection ? `/trama/colecoes/${entry.data.collection}/` : "/trama/"}>← Voltar</a>
      {entry.data.node && <code>{entry.data.node}</code>}
      <nav>
        <p>Na página</p>
        <ol>
          {headings.filter((heading) => heading.depth === 2).map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
        </ol>
      </nav>
    </aside>
    <article class="doc-article">
      <header class="doc-article__header">
        <p class="eyebrow">{entry.data.collection ? `Coleção ${entry.data.collection}` : entry.data.section === "por-dentro" ? "Por dentro do trama" : "Comece aqui"}</p>
        <h1>{entry.data.title}</h1>
        <p class="lede">{entry.data.description}</p>
      </header>
      <div class="prose"><Content /></div>
      {related.length > 0 && (
        <section class="related" aria-labelledby="related-title">
          <p class="eyebrow">Blocos próximos</p>
          <h2 id="related-title">Veja também</h2>
          <div class="related__links">
            {related.map((item) => {
              const visual = item.data.node ? getNodeVisual(item.data.node) : undefined;
              return <a href={`/trama/${item.id}/`}>
                {visual && <NodeMini label={item.data.title} {...visual} />}
                <strong>{item.data.title}</strong><span>{item.data.description}</span><b aria-hidden="true">→</b>
              </a>;
            })}
          </div>
        </section>
      )}
    </article>
  </div>
</Base>
