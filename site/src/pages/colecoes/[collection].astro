---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import CollectionHero from "../../components/CollectionHero.astro";
import NodeMini from "../../components/NodeMini.astro";
import { collections } from "../../data/collections";
import { getNodeVisual } from "../../data/node-visuals";

export async function getStaticPaths() {
  return collections.map(({ id }) => ({ params: { collection: id } }));
}

const collection = Astro.params.collection;
const entries = (await getCollection("docs", ({ data }) => data.collection === collection))
  .sort((a, b) =>
    Number(Boolean(a.data.node)) - Number(Boolean(b.data.node)) ||
    a.data.order - b.data.order ||
    a.data.title.localeCompare(b.data.title, "pt-BR")
  );
const info = collections.find(({ id }) => id === collection)!;
---

<Base title={info.title} description={info.description}>
  <div class="doc-shell" data-pagefind-body>
    <CollectionHero {...info} />
    <section class="catalogue" aria-labelledby="catalogue-title">
      <div class="section-intro">
        <h2 id="catalogue-title">Blocos e guias.</h2>
      </div>
      <div class="catalogue-list">
        {entries.map((entry) => {
          const visual = entry.data.node ? getNodeVisual(entry.data.node) : undefined;
          return (
            <a class:list={["catalogue-entry", { "catalogue-entry--guide": !entry.data.node }]} href={`/trama/${entry.id}/`}>
              {visual
                ? <NodeMini label={entry.data.title} {...visual} />
                : <span class="catalogue-entry__guide">guia</span>}
              <span class="catalogue-entry__meta">{entry.data.node ?? "visão geral"}</span>
              <span class="catalogue-entry__main"><strong>{entry.data.title}</strong><em>{entry.data.description}</em></span>
              <span class="catalogue-entry__arrow" aria-hidden="true">→</span>
            </a>
          );
        })}
      </div>
    </section>
  </div>
</Base>
