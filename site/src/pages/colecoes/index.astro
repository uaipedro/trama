---
import Base from "../../layouts/Base.astro";
import CollectionCard from "../../components/CollectionCard.astro";
import { collections } from "../../data/collections";
---

<Base title="Coleções" description="Cada coleção é um pacote de blocos para um tipo de trabalho.">
  <section class="home-collections" aria-labelledby="collections-title" data-pagefind-body>
    <div class="section-intro">
      <p class="eyebrow">Coleções</p>
      <h1 id="collections-title">Coleções</h1>
      <p class="lede">Cada coleção é um pacote de blocos para um tipo de trabalho.</p>
    </div>
    <div class="collection-cards">
      {collections.map((collection) => <CollectionCard collection={collection} />)}
    </div>
  </section>
</Base>
