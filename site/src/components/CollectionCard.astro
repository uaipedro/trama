---
import type { collections } from "../data/collections";

type Collection = (typeof collections)[number];

interface Props {
  collection: Collection;
  instalada?: boolean;
}

const { collection, instalada = false } = Astro.props;
---

<a class="catalogue-entry collection-entry" href={`/trama/colecoes/${collection.id}/`}>
  <span class="catalogue-entry__meta">{collection.packageName}{instalada && <span class="collection-entry__badge">vem instalada</span>}</span>
  <span class="catalogue-entry__main">
    <strong>{collection.title}</strong>
    <em>{collection.description}</em>
  </span>
  <span class="catalogue-entry__arrow" aria-hidden="true">→</span>
</a>
