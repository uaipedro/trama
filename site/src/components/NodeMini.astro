---
interface Props {
  label: string;
  accent: string;
  icon?: "sheet" | "summary" | "sigma" | "scatter" | "histogram";
  hasInput?: boolean;
}

const { label, accent, icon = "sheet", hasInput = true } = Astro.props;
---

<span class="node-miniature" style={`--node-accent: ${accent}`} aria-hidden="true">
  {hasInput && <i class="node-miniature__port node-miniature__port--in"></i>}
  <span class="node-miniature__body">
    {icon === "sheet" && <svg viewBox="0 0 24 24"><path d="M5 3h11l3 3v15H5z"/><path d="M8 10h8M8 14h8M8 18h5M15 3v4h4"/></svg>}
    {icon === "summary" && <svg viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="1"/><path d="M9 3h6v3H9zM9 11h6M9 15h6M9 19h4"/></svg>}
    {icon === "sigma" && <svg viewBox="0 0 24 24"><path d="M17 4H7l6 8-6 8h10"/></svg>}
    {icon === "scatter" && <svg viewBox="0 0 24 24"><path d="M4 19V5M4 19h16"/><circle cx="9" cy="14" r="1.4"/><circle cx="13" cy="10" r="1.4"/><circle cx="17" cy="7" r="1.4"/></svg>}
    {icon === "histogram" && <svg viewBox="0 0 24 24"><path d="M4 20V5M4 20h16"/><path d="M7 17v-4h3v4M11 17V8h3v9M15 17v-7h3v7"/></svg>}
    <span>{label}</span>
  </span>
  <i class="node-miniature__port node-miniature__port--out"></i>
</span>
