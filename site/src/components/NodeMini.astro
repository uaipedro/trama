---
interface Props {
  label: string;
  accent: string;
  icon?: string;
  hasInput: boolean;
  hasOutput: boolean;
  inputColor?: string;
  outputColor?: string;
}

const { label, accent, icon, hasInput, hasOutput, inputColor, outputColor } = Astro.props;
---

<!-- Mesma etiqueta do modo mini do editor: ícone no bloco da categoria,
     rótulo, grade de ranhuras e as portas coladas na borda. -->
<span class="node-miniature" style={`--node-accent: ${accent}`} aria-hidden="true">
  {hasInput && <i class="node-miniature__port node-miniature__port--in" style={inputColor && `--porta-cor: ${inputColor}`}></i>}
  <span class="node-miniature__icon">
    {icon ? <svg viewBox="0 0 24 24"><use href={`/trama/icons/lucide.svg#${icon}`} /></svg> : <i class="node-miniature__fallback"></i>}
  </span>
  <span class="node-miniature__label">{label}</span>
  <i class="node-miniature__grip"></i>
  {hasOutput && <i class="node-miniature__port node-miniature__port--out" style={outputColor && `--porta-cor: ${outputColor}`}></i>}
</span>
