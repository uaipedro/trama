---
interface Props {
  label: string;
  accent: string;
  icon?: string;
  hasInput: boolean;
  hasOutput: boolean;
}

const { label, accent, icon, hasInput, hasOutput } = Astro.props;
---

<span class="node-miniature" style={`--node-accent: ${accent}`} aria-hidden="true">
  {hasInput && <i class="node-miniature__port node-miniature__port--in"></i>}
  <span class="node-miniature__body">
    <span class="node-miniature__header">
      {icon ? <svg viewBox="0 0 24 24"><use href={`/trama/icons/lucide.svg#${icon}`} /></svg> : <i class="node-miniature__fallback"></i>}
    </span>
    <span>{label}</span>
  </span>
  {hasOutput && <i class="node-miniature__port node-miniature__port--out"></i>}
</span>
