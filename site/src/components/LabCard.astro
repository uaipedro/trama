---
// Card do laboratório: mesma marcação da vitrine, reaproveitada na trama.
interface Props { exemplo: any; modos: readonly { id: string; nome: string }[]; id?: string; modo?: string }
const { exemplo, modos, id, modo = "completo" } = Astro.props;
---
              <div class:list={["tr-node", `tr-state-${exemplo.estado}`, { "tr-node-mini": modo === "mini" }]} data-mode={modo} data-no={id} style={`--tr-w: 240px; --tr-h: 132px; --amostra-cor: ${exemplo.cor}; --tr-cat: ${exemplo.cor}; --tr-cat-ink: #0b0e13`}>
                <div class="tr-node-head" style={`background:${exemplo.cor}`}>
                  <svg class="tr-node-icon tr-node-icon-main" viewBox="0 0 24 24" aria-hidden="true"><use href={`/trama/icons/lucide.svg#${exemplo.icone}`} /></svg>
                  <span class="tr-node-title">{exemplo.titulo}</span>
                  {exemplo.estado === "cached" && <span class="tr-dot" title="cache"></span>}
                  <span class={`tr-mini-dot tr-${exemplo.estado}`} title={exemplo.estado} aria-hidden="true"></span>
                  <div class="tr-modo-picker nodrag" role="group" aria-label={`Modo de ${exemplo.titulo}`}>
                    {modos.map((modo) => <button type="button" class:list={["tr-modo-btn", { "tr-on": modo.id === "completo" }]} data-modo-card={modo.id} title={modo.nome} aria-label={modo.nome} aria-pressed={modo.id === "completo"}>
                      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                        {modo.id === "mini" ? <rect x="5" y="5" width="6" height="6" rx="1" fill="currentColor" /> : <><rect x="2" y="2" width="12" height="5" rx="1" fill={modo.id === "params" ? "none" : "currentColor"} stroke="currentColor" stroke-width="1.4" /><rect x="2" y="9" width="12" height="5" rx="1" fill={modo.id === "preview" ? "none" : "currentColor"} stroke="currentColor" stroke-width="1.4" /></>}
                      </svg>
                    </button>)}
                  </div>
                </div>

                <div class:list={["tr-preview", { "tr-preview-error": exemplo.estado === "failed", "tr-busy": exemplo.estado === "running" }]}>
                  {exemplo.tipo === "tabela" && <table class="tr-table"><thead><tr><th>weight</th><th>Time</th><th>Chick</th></tr></thead><tbody><tr><td>42</td><td>0</td><td>1</td></tr><tr><td>51</td><td>2</td><td>1</td></tr><tr><td>59</td><td>4</td><td>1</td></tr></tbody></table>}
                  {exemplo.tipo === "resumo" && <table class="tr-table"><thead><tr><th>coluna</th><th>faltantes</th><th>distintos</th></tr></thead><tbody><tr><td>weight</td><td>0</td><td>212</td></tr><tr><td>Time</td><td>0</td><td>12</td></tr><tr><td>Chick</td><td>0</td><td>50</td></tr></tbody></table>}
                  {exemplo.tipo === "limpeza" && <table class="tr-table"><thead><tr><th>antes</th><th>depois</th></tr></thead><tbody><tr><td>Weight</td><td>weight</td></tr><tr><td>Time</td><td>time</td></tr><tr><td>Chick</td><td>chick</td></tr></tbody></table>}
                  {exemplo.tipo === "modelo" && <dl class="tr-kv"><dt>Modelo</dt><dd>linear misto</dd><dt>Fórmula</dt><dd>weight ~ Time + (1|Chick)</dd><dt>REML</dt><dd>sim</dd></dl>}
                  {exemplo.tipo === "grafico" && <div class="tr-img-wrap"><svg class="lab__grafico" viewBox="0 0 210 105" role="img" aria-label="Dispersão de peso por tempo"><path d="M20 8V90H205" stroke="currentColor" fill="none" opacity=".5"/><g fill="#f472b6"><circle cx="28" cy="78" r="3"/><circle cx="51" cy="71" r="3"/><circle cx="73" cy="60" r="3"/><circle cx="99" cy="57" r="3"/><circle cx="121" cy="43" r="3"/><circle cx="145" cy="47" r="3"/><circle cx="174" cy="24" r="3"/><circle cx="195" cy="20" r="3"/></g></svg></div>}
                  {exemplo.tipo === "arquivo" && <div class="tr-text">saida/pintos.csv<br />578 linhas gravadas</div>}
                  {exemplo.tipo === "arima" && <div class="tr-progress"><div class="tr-progress-fill" style="width:46%"></div><span class="tr-progress-msg">ajustando modelo…</span></div>}
                  {exemplo.tipo === "avaliacao" && <div class="tr-err-msg">A coluna .pred não foi encontrada.</div>}
                  {exemplo.tipo === "serie" && <div class="tr-img-wrap"><svg class="lab__grafico" viewBox="0 0 210 105" role="img" aria-label="Série AirPassengers"><path d="M20 8V90H205" stroke="currentColor" fill="none" opacity=".5"/><path d="M23 78 38 76 52 72 67 75 82 66 98 69 113 58 129 60 144 45 160 51 175 34 190 24 204 15" stroke="#34d399" stroke-width="2" fill="none"/></svg></div>}
                  {exemplo.tipo === "teste" && <table class="tr-table"><thead><tr><th>termo</th><th>AIC</th><th>p-valor</th></tr></thead><tbody><tr><td>completo</td><td>5.620,71</td><td>—</td></tr><tr><td>Chick</td><td>5.797,16</td><td>&lt;0,001</td></tr><tr><td>Diet</td><td>5.627,40</td><td>0,003</td></tr></tbody></table>}
                </div>
                <div class="tr-tabs"><span class="tr-tab-only">{exemplo.vista}</span></div>

                {exemplo.params.length > 0 && <div class="tr-params">
                  {exemplo.params.map((parametro) => <div class:list={["tr-param", { "tr-param-longo": parametro.nome.length > 16 }]}><span>{parametro.nome}</span><input class="nodrag" type="text" value={parametro.valor} aria-label={parametro.nome} /></div>)}
                </div>}

                <div class="tr-ports">
                  <div class="tr-in">{"entrada" in exemplo && <div class="tr-port"><span class={`react-flow__handle lab__handle--in lab__handle--${exemplo.entrada[2]}`} style={`background:${exemplo.entrada[1]}`}></span><span class="lab__nome-porta">{exemplo.entrada[0]}</span></div>}</div>
                  <div class="tr-out"><div class="tr-port tr-port-out"><span class="lab__nome-porta">{exemplo.saida[0]}</span><span class={`react-flow__handle lab__handle--out lab__handle--${exemplo.saida[2]}`} style={`background:${exemplo.saida[1]}`}></span></div></div>
                </div>
                <div class="tr-grip" aria-hidden="true"></div>
              </div>