#!/usr/bin/env Rscript
# CLI do canal de controle: fala com o editor aberto por trama::tr_app().
# Instale com: ln -s "$(Rscript -e 'cat(system.file("bin/trama-agente", package="trama"))')" ~/.local/bin/trama-agente
# Desenvolvendo o trama: TRAMA_DEV=<raiz do repo> carrega o código de lá.
dev <- Sys.getenv("TRAMA_DEV")
if (nzchar(dev)) {
  suppressMessages(pkgload::load_all(dev, quiet = TRUE))
  tr_cli <- get("tr_cli", envir = asNamespace("trama"))
} else {
  tr_cli <- trama::tr_cli
}
res <- tr_cli(commandArgs(TRUE))
quit(status = if (isTRUE(res$ok)) 0L else 1L, save = "no")
